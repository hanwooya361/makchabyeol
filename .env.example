# ── 프론트엔드 (frontend/.env.local 에 복사) ──
# API 주소
VITE_API_BASE_URL=http://localhost:8080
# 외부 후원 링크. 비워 두면 후원 링크가 보이지 않음
VITE_DONATION_URL=

# ── 백엔드 (IDE 실행 설정 또는 배포 플랫폼 환경변수) ──
# local: H2 메모리 DB / prod: PostgreSQL(Neon)
SPRING_PROFILES_ACTIVE=local
# prod 전용. 예: jdbc:postgresql://<host>/<db>?sslmode=require
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
# 허용할 프론트 주소. 쉼표로 여러 개
ALLOWED_ORIGINS=http://localhost:5173
