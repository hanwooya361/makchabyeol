# 자리표시자만 둔다. 실제 값은 이 파일에 쓰지 않는다(이 저장소는 public).

# ── 프론트엔드 (frontend/.env.local 에 복사) ──
# VITE_로 시작하는 값은 빌드 결과에 그대로 들어가 누구나 볼 수 있다. 공개해도 되는 값만, 비밀은 절대 넣지 않는다
# API 주소
VITE_API_BASE_URL=http://localhost:8080
# 외부 후원 링크. 비워 두면 후원 링크가 보이지 않음
VITE_DONATION_URL=
# 배포된 사이트 주소(끝 / 없이). 링크 미리보기 이미지(og:image)가 전체 주소여야 해서 빌드 때 넣음
VITE_SITE_URL=http://localhost:5173

# ── 백엔드 (IDE 실행 설정 또는 배포 플랫폼 환경변수) ──
# 비밀값(DB 비밀번호, API 키, 웹훅 주소)은 여기, 백엔드에만
# local: H2 메모리 DB / prod: PostgreSQL(Neon)
SPRING_PROFILES_ACTIVE=local
# prod 전용. 예: jdbc:postgresql://<host>/<db>?sslmode=require
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
# 허용할 프론트 주소. 쉼표로 여러 개
ALLOWED_ORIGINS=http://localhost:5173
